{
  "name": "juggle",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source bring-your-own-key AI gateway: one OpenAI-compatible endpoint, your provider keys, automatic failover.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:prune": "tsx scripts/prune.ts",
    "secrets:generate": "tsx scripts/generate-secrets.ts",
    "mock:gemini": "tsx scripts/mock-gemini.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "openai": "^7.20.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.20.0"
}
