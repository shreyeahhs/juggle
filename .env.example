###############################################################################
# Juggle configuration
#
# Copy to .env and fill in. NEVER commit .env: it is git-ignored on purpose.
# Generate the secrets with:  pnpm secrets:generate
#
# Juggle is single-tenant: one owner, everything configured here. Your provider
# keys live in this file (or your host's environment), never in the database.
###############################################################################

# ── Required ─────────────────────────────────────────────────────────────────
# Public base URL of this deployment. Must be https:// in production.
APP_URL="http://localhost:3000"

# Signs the dashboard session cookie and derives key fingerprints (min 32 chars).
AUTH_SECRET=""

# The password for the dashboard. This deployment has no other account.
OWNER_PASSWORD=""

# Your Gemini API keys, comma-separated. Optionally name them with `name=key`,
# and name the project they belong to with `name@group=key`:
#   GEMINI_API_KEYS="AQ.Ab8...1,spare=AQ.Ab8...2"
#   GEMINI_API_KEYS="a@project-1=AQ.Ab8...1,b@project-2=AQ.Ab8...2"
# Requests cycle through them one by one. Add as many as you like.
GEMINI_API_KEYS=""

# The token(s) your applications send as `Authorization: Bearer <token>`.
# Comma-separated, optionally named: `prod=gw_live_...,dev=gw_live_...`
GATEWAY_API_KEYS=""

# PostgreSQL, for usage statistics and shared cooldowns.
# Leave unset in development to use an embedded database (PGlite) in ./.data.
# Required in production; on Vercel use Neon, Vercel Postgres or Supabase.
# DATABASE_URL="postgres://juggle:juggle@localhost:5432/juggle"
DATABASE_POOL_MAX="10"

# ── Optional: keys ───────────────────────────────────────────────────────────
# Gemini rate limits apply per Google Cloud project, not per key. Keys from one
# project share a quota, so a 429 on any of them means all of them are spent.
#
# This is the default group for keys that do not name one with `name@group=key`.
# Set it only when EVERY key comes from the same project. With keys from two
# projects, group them inline instead: one shared group would park keys that
# still have quota, costing you the headroom the second project was for.
GEMINI_QUOTA_GROUP=""

# How keys are cycled:
#   round_robin  (default) strict least-recently-used: every request moves to
#                the next key, which is the best way to avoid limits at all.
#   power_of_two sample two and take the less recently used; fewer collisions
#                when many requests are in flight at once.
GATEWAY_KEY_STRATEGY="round_robin"

# ── Optional: behaviour ──────────────────────────────────────────────────────
GATEWAY_MAX_ATTEMPTS="5"              # upstream attempts per request, all keys
GATEWAY_MAX_TRANSIENT_RETRIES="2"     # retries for 5xx / timeouts / network
GATEWAY_UPSTREAM_TIMEOUT_MS="120000"
GATEWAY_STREAM_IDLE_TIMEOUT_MS="60000"
GATEWAY_REQUEST_DEADLINE_MS="300000"
GATEWAY_MAX_BODY_BYTES="4194304"

# ── Optional: limits (protect your own quota and bill) ───────────────────────
GATEWAY_TOKEN_RPM="120"               # per gateway token, per minute
GATEWAY_TOTAL_RPM="300"               # whole deployment, per minute
GATEWAY_DAILY_REQUESTS="20000"        # whole deployment, per day
GATEWAY_MAX_CONCURRENCY="20"
GATEWAY_AUTH_FAILURES_PER_MINUTE="30"
# Browser origins allowed to call /v1 directly. Empty (recommended): none.
# Gateway tokens belong on your server, not in frontend code.
GATEWAY_CORS_ORIGINS=""

# ── Optional: providers ──────────────────────────────────────────────────────
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
# Cooldown for a 429 that carries no retry hint from the provider (seconds).
GEMINI_DEFAULT_COOLDOWN_SECONDS="1800"

# ── Optional: operations ─────────────────────────────────────────────────────
SESSION_MAX_AGE_DAYS="30"
# Days of request metadata to keep. `pnpm db:prune` deletes anything older.
REQUEST_LOG_RETENTION_DAYS="30"
# Apply pending migrations at startup. Handy for single-container deployments.
RUN_MIGRATIONS="false"
# Set true ONLY behind a proxy that sets x-forwarded-for (Vercel, Fly, nginx…).
TRUST_PROXY="false"
LOG_LEVEL="info"

# Used by docker-compose.yml to provision the bundled PostgreSQL container.
POSTGRES_PASSWORD=""
