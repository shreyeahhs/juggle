# ─── Secrets ─────────────────────────────────────────────────────────────────
# Never commit real environment files. Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ─── Local data ──────────────────────────────────────────────────────────────
# Embedded development database (PGlite) and any local dumps
/.data/
*.sql.gz
*.dump

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Build output ────────────────────────────────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage
/test-results
/playwright-report

# ─── Logs & OS/editor noise ──────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ─── Deploy platforms ────────────────────────────────────────────────────────
.vercel
.fly/
